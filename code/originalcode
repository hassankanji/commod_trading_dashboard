def recompute(*_):
    # "Apply controls" means:
    # use the already downloaded price/IV data in STATE and rerun the signal logic.
    # It does not hit Bloomberg again.
    if "px" not in STATE:
        status.value = f"<span style='color:{AMBER}'>Click Refresh data first.</span>"
        return

    res = build_signals(
        STATE["px"],
        STATE["iv"],
        lookback_dd.value,
        iv_lo.value,
        iv_hi.value,
        z_corr.value,
        gap_sl.value,
        min_vol_quality.value,
        exclude_stale_iv.value,
        min_leadlag_corr.value,
        max_per_engine.value,
        max_per_asset_class.value,
    )

    STATE["res"] = res

    ideas_box.children = [render_ideas(res)]
    iv_table_box.children = [render_iv_table(res)]

    if res["disloc"]:
        d = sorted(res["disloc"], key=lambda x: -abs(x["z"]))

        html = "".join(
            f"<div style='padding:6px 0;border-bottom:1px solid {GRID};"
            f"font:400 12px Inter,Arial;color:{TXT}'>"
            f"<b>{x['pair']}</b> | {x['note']} | {x['action']}</div>"
            for x in d[:20]
        )

        disloc_box.children = [
            widgets.HTML(
                f"<div style='font:600 11px Inter,Arial;color:{MUTED};"
                f"letter-spacing:.06em;margin-bottom:4px'>CORRELATION DISLOCATIONS</div>{html}"
            )
        ]
    else:
        disloc_box.children = [
            widgets.HTML(f"<div style='color:{MUTED}'>None above threshold.</div>")
        ]

    corr_heat_box.children = [corr_heatmap(res)]

    redraw_iv_chart()
    redraw_pair_chart()

    status.value = (
        f"<span style='color:{GREEN}'>Loaded. "
        f"{len(res['ideas'])} shown from {len(res['raw_ideas'])} raw signals.</span>"
    )


def refresh(*_):
    status.value = f"<span style='color:{MUTED}'>Fetching data</span>"

    try:
        px, iv, px_fail, iv_fail = fetch_all(status)

        STATE["px"], STATE["iv"] = px, iv

        iv_drill_dd.options = [(NAME.get(t, t), t) for t in iv.columns]
        corr_opts = [(NAME.get(t, t), t) for t in px.columns]

        pair_a_dd.options = corr_opts
        pair_b_dd.options = corr_opts

        if iv.columns.size:
            iv_drill_dd.value = iv.columns[0]

        if len(corr_opts) > 1:
            pair_a_dd.value = corr_opts[0][1]
            pair_b_dd.value = corr_opts[1][1]

        recompute()

        warn = ""

        if px_fail:
            warn += (
                f"<br><span style='color:{AMBER}'>No price data: "
                f"{', '.join(NAME.get(t, t) for t in px_fail)}</span>"
            )

        if iv_fail:
            warn += (
                f"<br><span style='color:{AMBER}'>No IV data: "
                f"{', '.join(NAME.get(t, t) for t in iv_fail)}</span>"
            )

        status.value = (
            f"<span style='color:{GREEN}'>Data loaded. "
            f"{px.shape[1]} price assets, {iv.shape[1]} IV assets.</span>{warn}"
        )

    except Exception as e:
        status.value = f"<span style='color:{RED}'>Error: {e}</span>"


def redraw_iv_chart(*_):
    if "res" in STATE and iv_drill_dd.value:
        iv_chart_box.children = [iv_drill_fig(STATE["res"], iv_drill_dd.value)]


def redraw_pair_chart(*_):
    if (
        "res" in STATE
        and pair_a_dd.value
        and pair_b_dd.value
        and pair_a_dd.value != pair_b_dd.value
    ):
        corr_pair_box.children = [
            corr_pair_fig(STATE["res"], pair_a_dd.value, pair_b_dd.value)
        ]


refresh_btn.on_click(refresh)
recompute_btn.on_click(recompute)

