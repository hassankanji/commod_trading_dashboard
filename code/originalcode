def render_ideas(res):
    df = res["ideas"]

    if df.empty:
        return widgets.HTML(
            f"<div style='color:{MUTED};padding:20px'>No signals crossed the current filters.</div>"
        )

    rows = ""

    for _, r in df.iterrows():
        bias = str(r["bias"])

        if "BUY VOL" in bias or bias.startswith("BUY") or "BUY " in bias:
            biasclr = GREEN
        elif "SELL VOL" in bias or bias.startswith("SELL") or "SELL " in bias:
            biasclr = RED
        else:
            biasclr = TXT

        q = f"Q{r['quality']}" if r.get("quality", "") else ""

        rows += (
            f"<tr style='border-bottom:1px solid {GRID}'>"
            f"<td style='padding:9px 10px'>{_chip(r['engine'], TYPE_CLR.get(r['engine'], MUTED))}</td>"
            f"<td style='padding:9px 10px;font:600 13px Inter,Arial;color:{TXT}'>{r['name']}</td>"
            f"<td style='padding:9px 10px;font:400 12px Inter,Arial;color:{TXT}'>{r['signal']}</td>"
            f"<td style='padding:9px 10px;font:700 12px Inter,Arial;color:{biasclr}'>{r['bias']}</td>"
            f"<td style='padding:9px 10px;font:400 11px Inter,Arial;color:{MUTED}'>{r['detail']}</td>"
            f"<td style='padding:9px 10px;font:600 11px Inter,Arial;color:{MUTED}'>{q}</td>"
            f"</tr>"
        )

    return widgets.HTML(
        f"<div style='font:400 12px Inter,Arial;color:{MUTED};margin:2px 0 8px'>"
        f"{len(df)} shown from {len(res['raw_ideas'])} raw signals</div>"
        f"<table style='border-collapse:collapse;width:100%;background:{PANEL};"
        f"border:1px solid {GRID};border-radius:10px;overflow:hidden'>"
        f"<tr style='background:#1C2230'>"
        f"<th style='text-align:left;padding:8px 10px;font:600 11px Inter,Arial;color:{MUTED}'>ENGINE</th>"
        f"<th style='text-align:left;padding:8px 10px;font:600 11px Inter,Arial;color:{MUTED}'>ASSET / PAIR</th>"
        f"<th style='text-align:left;padding:8px 10px;font:600 11px Inter,Arial;color:{MUTED}'>TRIGGER</th>"
        f"<th style='text-align:left;padding:8px 10px;font:600 11px Inter,Arial;color:{MUTED}'>ACTION</th>"
        f"<th style='text-align:left;padding:8px 10px;font:600 11px Inter,Arial;color:{MUTED}'>NOTES</th>"
        f"<th style='text-align:left;padding:8px 10px;font:600 11px Inter,Arial;color:{MUTED}'>VOL Q</th>"
        f"</tr>{rows}</table>"
    )


def render_iv_table(res):
    t = res["iv_table"].copy()

    if t.empty:
        return widgets.HTML(f"<div style='color:{MUTED}'>No IV data.</div>")

    t = t.sort_values(["stale_iv", "quality", "iv_pct"])

    rows = ""

    for _, r in t.iterrows():
        def heat(p):
            if np.isnan(p):
                return MUTED
            return RED if p >= 80 else GREEN if p <= 20 else TXT

        stale_txt = "STALE" if r["stale_iv"] else ""
        stale_clr = AMBER if r["stale_iv"] else MUTED

        rows += (
            f"<tr style='border-bottom:1px solid {GRID}'>"
            f"<td style='padding:7px 10px;font:600 12px Inter,Arial;color:{TXT}'>{r['name']}</td>"
            f"<td style='padding:7px 10px;color:{MUTED}'>{r['asset_class']}</td>"
            f"<td style='padding:7px 10px;text-align:center;color:{MUTED}'>{r['quality']}</td>"
            f"<td style='padding:7px 10px;text-align:center;color:{stale_clr}'>{stale_txt}</td>"
            f"<td style='padding:7px 10px;text-align:right;color:{TXT}'>{r['iv']:.1f}</td>"
            f"<td style='padding:7px 10px;text-align:right;font:600 12px Inter,Arial;color:{heat(r['iv_pct'])}'>{r['iv_pct']:.0f}</td>"
            f"<td style='padding:7px 10px;text-align:right;color:{TXT}'>{r['rv']:.1f}</td>"
            f"<td style='padding:7px 10px;text-align:right;color:{TXT}'>{r['vrp']:+.1f}</td>"
            f"<td style='padding:7px 10px;text-align:right;font:600 12px Inter,Arial;color:{heat(r['vrp_pct'])}'>{r['vrp_pct']:.0f}</td>"
            f"</tr>"
        )

    return widgets.HTML(
        f"<table style='border-collapse:collapse;width:100%;background:{PANEL};"
        f"border:1px solid {GRID};border-radius:10px;overflow:hidden'>"
        f"<tr style='background:#1C2230'>"
        + "".join(
            f"<th style='padding:8px 10px;text-align:{al};font:600 11px Inter,Arial;color:{MUTED}'>{h}</th>"
            for h, al in [
                ("ASSET", "left"),
                ("CLASS", "left"),
                ("Q", "center"),
                ("STALE", "center"),
                ("IV", "right"),
                ("IV PCTILE", "right"),
                ("REALIZED", "right"),
                ("IV-RV", "right"),
                ("IV-RV PCTILE", "right"),
            ]
        )
        + f"</tr>{rows}</table>"
    )


def iv_drill_fig(res, tk):
    iv, rv = res["iv"], res["rv"]

    s_iv = iv[tk].dropna()
    s_rv = rv[tk].reindex(s_iv.index)

    fig = go.Figure()

    fig.add_trace(
        go.Scatter(
            x=s_iv.index,
            y=s_iv,
            name="Implied vol",
            line=dict(color=BLUE, width=2.2),
        )
    )

    fig.add_trace(
        go.Scatter(
            x=s_rv.index,
            y=s_rv,
            name="Realized vol",
            line=dict(color=AMBER, width=1.6, dash="dot"),
        )
    )

    for q, lbl in [(0.1, "10th"), (0.9, "90th")]:
        fig.add_hline(
            y=s_iv.quantile(q),
            line=dict(color="#555", width=1, dash="dash"),
            annotation_text=f"IV {lbl}",
            annotation_font_color=MUTED,
        )

    stale, zero_ratio, recent_range = stale_iv_stats(s_iv)
    stale_note = " | stale-IV flag" if stale else ""

    fig.update_layout(
        template="plotly_dark",
        height=420,
        paper_bgcolor=BG,
        plot_bgcolor=BG,
        title=f"<b>{NAME.get(tk, tk)} - Implied vs Realized Vol{stale_note}</b>",
        font=dict(family="Inter", color=TXT),
        hovermode="x unified",
        legend=dict(orientation="h", y=1.02, x=1, xanchor="right"),
        margin=dict(l=55, r=20, t=60, b=35),
        xaxis=dict(gridcolor=GRID),
        yaxis=dict(title="vol %", gridcolor=GRID),
    )

    return go.FigureWidget(fig)


def corr_heatmap(res):
    c = res["corr_now"].copy()

    if c.empty:
        return widgets.HTML(f"<div style='color:{MUTED}'>No correlation data.</div>")

    labels = [NAME.get(t, t) for t in c.columns]

    fig = go.Figure(
        go.Heatmap(
            z=c.values,
            x=labels,
            y=labels,
            zmid=0,
            zmin=-1,
            zmax=1,
            colorscale="RdBu",
            reversescale=True,
            colorbar=dict(title="corr"),
        )
    )

    fig.update_layout(
        template="plotly_dark",
        height=620,
        paper_bgcolor=BG,
        plot_bgcolor=BG,
        title=f"<b>{CORR_WINDOW}d Correlation Matrix</b>",
        font=dict(family="Inter", color=TXT, size=10),
        margin=dict(l=110, r=20, t=60, b=110),
        xaxis=dict(tickangle=-45),
    )

    return go.FigureWidget(fig)


def corr_pair_fig(res, a, b):
    ret = res["ret"]

    rcr = ret[a].rolling(CORR_WINDOW).corr(ret[b]).dropna()

    if rcr.empty:
        return widgets.HTML(f"<div style='color:{MUTED}'>No pair data.</div>")

    mean, sd = rcr.mean(), rcr.std()

    win = ret[[a, b]].tail(CORR_WINDOW).dropna()
    k, pk = lead_lag(win[a], win[b]) if len(win) else (0, np.nan)

    na, nb = NAME.get(a, a), NAME.get(b, b)

    if k > 0:
        ll = f"{na} leads {nb} by {k}d, peak r {pk:+.2f}"
    elif k < 0:
        ll = f"{nb} leads {na} by {abs(k)}d, peak r {pk:+.2f}"
    else:
        ll = "no lead-lag"

    fig = go.Figure()

    fig.add_trace(
        go.Scatter(
            x=rcr.index,
            y=rcr,
            name="60d corr",
            line=dict(color=BLUE, width=2.2),
        )
    )

    fig.add_hline(y=mean, line=dict(color=MUTED, width=1))

    if pd.notna(sd):
        for s, lbl in [(2, "+2sd"), (-2, "-2sd")]:
            fig.add_hline(
                y=mean + s * sd,
                line=dict(color="#555", width=1, dash="dash"),
                annotation_text=lbl,
                annotation_font_color=MUTED,
            )

    fig.update_layout(
        template="plotly_dark",
        height=420,
        paper_bgcolor=BG,
        plot_bgcolor=BG,
        title=f"<b>{na} / {nb}</b> | {ll}",
        font=dict(family="Inter", color=TXT),
        hovermode="x unified",
        margin=dict(l=55, r=20, t=60, b=35),
        xaxis=dict(gridcolor=GRID),
        yaxis=dict(title="correlation", gridcolor=GRID),
    )

    return go.FigureWidget(fig)


