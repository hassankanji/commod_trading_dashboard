def _pull(tickers, item_fn, start, end):
    field = item_fn(dates=bq.func.range(start, end))
    frames, failed = {}, []

    for tk in tickers:
        try:
            res = bq.execute(bql.Request(tk, field))
            d = res[0].df().reset_index()
            d = d.drop(columns=[c for c in ["CURRENCY"] if c in d.columns])

            vcols = [c for c in d.columns if c not in ["ID", "DATE"]]
            if not vcols:
                failed.append(tk)
                continue

            vcol = vcols[0]
            s = d.set_index("DATE")[vcol].sort_index()
            s = s[~s.index.duplicated(keep="last")]

            if s.dropna().empty:
                failed.append(tk)
            else:
                frames[tk] = s

        except Exception:
            failed.append(tk)

    df = pd.DataFrame(frames).sort_index() if frames else pd.DataFrame()
    return df, failed


def fetch_all(progress=None):
    end = pd.Timestamp("today").strftime("%Y-%m-%d")
    start = (pd.Timestamp("today") - pd.DateOffset(years=HISTORY_YEARS)).strftime("%Y-%m-%d")

    if progress:
        progress.value = f"<span style='color:{MUTED}'>Pulling prices</span>"

    px, px_fail = _pull(ALL_TICKERS, bq.data.px_last, start, end)
    px = px.ffill()

    if progress:
        progress.value = f"<span style='color:{MUTED}'>Pulling implied vol</span>"

    iv, iv_fail = _pull(IV_TICKERS, bq.data.hist_put_imp_vol, start, end)
    iv = iv.ffill()

    return px, iv, px_fail, iv_fail


# -----------------------------------------------------------------------------
# Analytics helpers
# -----------------------------------------------------------------------------
def pct_rank(series, lookback):
    s = series.dropna()
    if len(s) < 20:
        return np.nan, np.nan, np.nan

    s = s.iloc[-lookback:] if lookback else s
    v = s.iloc[-1]

    pr = (s < v).mean() * 100
    sd = s.std()
    z = (v - s.mean()) / sd if sd and pd.notna(sd) else np.nan

    return v, pr, z


def realized_vol(px, window=RV_WINDOW):
    # Realized volatility:
    # daily returns -> rolling standard deviation -> annualized by sqrt(252)
    # This is backward-looking historical vol, not a market-implied future number.
    return px.pct_change().rolling(window).std() * np.sqrt(252) * 100


def stale_iv_stats(series, flat_window=15):
    s = series.dropna()
    if len(s) < flat_window + 5:
        return False, np.nan, np.nan

    recent = s.tail(flat_window)
    changes = recent.diff().abs().dropna()

    zero_change_ratio = (changes < 0.01).mean() if len(changes) else np.nan
    recent_range = recent.max() - recent.min()

    is_stale = (
        pd.notna(zero_change_ratio)
        and zero_change_ratio >= 0.80
        and pd.notna(recent_range)
        and recent_range <= 0.25
    )

    return is_stale, zero_change_ratio, recent_range


def lead_lag(x_ret, y_ret, max_lag=LEAD_LAG_MAX_DAYS):
    # corr(x_t, y_{t+k}); k > 0 means x tends to lead y by k days.
    best_k, best_c = 0, 0.0

    for k in range(-max_lag, max_lag + 1):
        c = x_ret.corr(y_ret.shift(-k))
        if pd.notna(c) and abs(c) > abs(best_c):
            best_k, best_c = k, c

    return best_k, best_c


def same_macro_or_asset_class(a, b):
    ca, cb = ASSET_CLASS.get(a), ASSET_CLASS.get(b)

    if ca is None or cb is None:
        return False

    if ca == "Macro" or cb == "Macro":
        return True

    return ca == cb


def allowed_corr_pair(a, b):
    # This removes economically random pairs like Silver / Soybean Meal.
    # Macro overlays are allowed against all commodities.
    return same_macro_or_asset_class(a, b)


def is_macro_pair(a, b):
    return ASSET_CLASS.get(a) == "Macro" or ASSET_CLASS.get(b) == "Macro"


def recent_return(px, tk, window):
    if tk not in px:
        return np.nan
    s = px[tk].dropna()
    if len(s) < window + 1:
        return np.nan
    return s.pct_change(window).iloc[-1] * 100


def pair_action_from_corr_break(px, a, b, z):
    ra = recent_return(px, a, PAIR_TRADE_RETURN_WINDOW)
    rb = recent_return(px, b, PAIR_TRADE_RETURN_WINDOW)

    if pd.isna(ra) or pd.isna(rb):
        return "No action", "Insufficient recent return history"

    na, nb = NAME.get(a, a), NAME.get(b, b)

    outperformer, underperformer = (a, b) if ra >= rb else (b, a)
    n_out, n_under = NAME.get(outperformer, outperformer), NAME.get(underperformer, underperformer)

    if z < 0:
        # Corr breakdown for related assets:
        # relationship has weakened; relative dispersion may be too wide.
        # Fade dispersion = buy underperformer / sell outperformer.
        bias = f"FADE: BUY {n_under} / SELL {n_out}"
        detail = f"20d returns: {na} {ra:+.1f}%, {nb} {rb:+.1f}%; corr breakdown"
    else:
        # Corr spike:
        # common-factor regime is stronger than usual.
        # Ride regime = stay with relative momentum until the regime weakens.
        bias = f"RIDE: BUY {n_out} / SELL {n_under}"
        detail = f"20d returns: {na} {ra:+.1f}%, {nb} {rb:+.1f}%; corr spike"

    return bias, detail


def add_idea(ideas, score, engine, asset_class, name, signal, bias, detail, quality=""):
    ideas.append(
        dict(
            score=float(score),
            engine=engine,
            asset_class=asset_class,
            name=name,
            signal=signal,
            bias=bias,
            detail=detail,
            quality=quality,
        )
    )


def cap_ideas(df, max_per_engine=7, max_per_asset_class=5):
    if df.empty:
        return df

    df = df.sort_values("score", ascending=False).copy()

    kept = []
    engine_counts = {}
    class_counts = {}

    for _, r in df.iterrows():
        eng = r["engine"]
        cls = r["asset_class"]

        if engine_counts.get(eng, 0) >= max_per_engine:
            continue

        if class_counts.get(cls, 0) >= max_per_asset_class:
            continue

        kept.append(r)
        engine_counts[eng] = engine_counts.get(eng, 0) + 1
        class_counts[cls] = class_counts.get(cls, 0) + 1

    return pd.DataFrame(kept).sort_values("score", ascending=False) if kept else pd.DataFrame()


# -----------------------------------------------------------------------------
# Main signal builder
# -----------------------------------------------------------------------------
def build_signals(
    px,
    iv,
    lookback,
    iv_lo,
    iv_hi,
    z_corr,
    gap_thresh,
    min_vol_quality,
    exclude_stale_iv,
    min_leadlag_corr,
    max_per_engine,
    max_per_asset_class,
):
    rv = realized_vol(px)
    ret = px.pct_change()

    ideas = []
    iv_rows = []

    min_quality_rank = QUALITY_RANK[min_vol_quality]

    # -------------------------------------------------------------------------
    # Engine 1: IV mean reversion
    # Engine 2: Variance risk premium
    # -------------------------------------------------------------------------
    for tk in iv.columns:
        nm = NAME.get(tk, tk)
        cls = ASSET_CLASS.get(tk, "Other")
        q = VOL_QUALITY.get(tk, "C")

        ivv, ivpr, ivz = pct_rank(iv[tk], lookback)
        if np.isnan(ivv):
            continue

        stale, zero_ratio, recent_range = stale_iv_stats(iv[tk])

        rv_last = rv[tk].dropna().iloc[-1] if tk in rv and rv[tk].dropna().size else np.nan

        vrp_series = (iv[tk] - rv[tk]).dropna() if tk in rv else pd.Series(dtype=float)
        vrpv, vrppr, vrpz = pct_rank(vrp_series, lookback) if len(vrp_series) else (np.nan, np.nan, np.nan)

        iv_rows.append(
            dict(
                name=nm,
                ticker=tk,
                asset_class=cls,
                quality=q,
                stale_iv=stale,
                iv=ivv,
                iv_pct=ivpr,
                iv_z=ivz,
                rv=rv_last,
                vrp=vrpv,
                vrp_pct=vrppr,
                vrp_z=vrpz,
                zero_change_ratio=zero_ratio,
                recent_iv_range=recent_range,
            )
        )

        quality_ok = QUALITY_RANK.get(q, 3) <= min_quality_rank
        stale_ok = (not exclude_stale_iv) or (not stale)

        if not quality_ok or not stale_ok:
            continue

        # IV mean-reversion:
        # Low IV percentile -> options look cheap vs their own history -> buy vol.
        # High IV percentile -> options look rich vs their own history -> sell vol.
        if ivpr <= iv_lo:
            add_idea(
                ideas,
                score=(50 - ivpr) / 50,
                engine="IV mean revert",
                asset_class=cls,
                name=nm,
                signal=f"IV {ivv:.1f} at {ivpr:.0f}th pctile",
                bias="BUY VOL",
                detail="Long straddle/gamma, strangle, call/put, debit spread, or variance if available",
                quality=q,
            )

        elif ivpr >= iv_hi:
            add_idea(
                ideas,
                score=(ivpr - 50) / 50,
                engine="IV mean revert",
                asset_class=cls,
                name=nm,
                signal=f"IV {ivv:.1f} at {ivpr:.0f}th pctile",
                bias="SELL VOL",
                detail="Short premium, credit spread, iron fly/condor, or variance if available",
                quality=q,
            )

        # Variance risk premium:
        # Live version compares today's implied vol to recent realized vol.
        # Comparing today's IV to future realized vol is correct for research,
        # but it would be look-ahead biased in a live dashboard.
        if not np.isnan(vrppr):
            if vrppr >= iv_hi:
                add_idea(
                    ideas,
                    score=(vrppr - 50) / 50,
                    engine="VRP",
                    asset_class=cls,
                    name=nm,
                    signal=f"IV-RV {vrpv:+.1f} vol pts at {vrppr:.0f}th pctile",
                    bias="SELL VOL",
                    detail=f"IV {ivv:.1f} vs realized {rv_last:.1f}",
                    quality=q,
                )

            elif vrppr <= iv_lo:
                add_idea(
                    ideas,
                    score=(50 - vrppr) / 50,
                    engine="VRP",
                    asset_class=cls,
                    name=nm,
                    signal=f"IV-RV {vrpv:+.1f} vol pts at {vrppr:.0f}th pctile",
                    bias="BUY VOL",
                    detail=f"IV {ivv:.1f} vs realized {rv_last:.1f}",
                    quality=q,
                )

    iv_table = pd.DataFrame(iv_rows)

    # -------------------------------------------------------------------------
    # Engine 3: Correlation break
    # Engine 4: Lead-lag catch-up
    # -------------------------------------------------------------------------
    cols = [c for c in PRICE_MAP.values() if c in ret.columns]
    corr_now = ret[cols].tail(CORR_WINDOW).corr() if cols else pd.DataFrame()

    disloc = []
    pairs = [
        (cols[i], cols[j])
        for i in range(len(cols))
        for j in range(i + 1, len(cols))
        if allowed_corr_pair(cols[i], cols[j])
    ]

    for a, b in pairs:
        na, nb = NAME.get(a, a), NAME.get(b, b)
        cls_a, cls_b = ASSET_CLASS.get(a, "Other"), ASSET_CLASS.get(b, "Other")
        pair_cls = "Macro" if is_macro_pair(a, b) else cls_a

        rcr = ret[a].rolling(CORR_WINDOW).corr(ret[b]).dropna()

        if len(rcr) < 80:
            continue

        cur = rcr.iloc[-1]
        mean = rcr.mean()
        sd = rcr.std()

        if not sd or pd.isna(sd):
            continue

        z = (cur - mean) / sd

        # Correlation break matters more when the pair is normally related.
        # This avoids clutter from weak relationships.
        normally_related = abs(mean) >= 0.35 if is_macro_pair(a, b) else abs(mean) >= 0.45

        if pd.notna(z) and abs(z) >= z_corr and normally_related:
            direction = "spike" if z > 0 else "breakdown"
            bias, detail = pair_action_from_corr_break(px, a, b, z)

            disloc.append(
                dict(
                    pair=f"{na} / {nb}",
                    a=a,
                    b=b,
                    corr=cur,
                    mean=mean,
                    z=z,
                    kind="regime",
                    note=f"corr {cur:+.2f}, avg {mean:+.2f}, z {z:+.1f}, {direction}",
                    action=bias,
                )
            )

            add_idea(
                ideas,
                score=min(abs(z) / 3, 1.5),
                engine="Correlation RV",
                asset_class=pair_cls,
                name=f"{na} / {nb}",
                signal=f"60d corr {cur:+.2f}, z {z:+.1f}",
                bias=bias,
                detail=detail,
                quality="",
            )

        # Lead-lag catch-up:
        # Restricted to logical pairs; macro allowed but still needs strong enough
        # peak lead-lag correlation in the current window.
        win = ret[[a, b]].tail(CORR_WINDOW).dropna()
        if len(win) < 40:
            continue

        k, pk = lead_lag(win[a], win[b])

        if k == 0 or abs(pk) < min_leadlag_corr:
            continue

        leader, follower = (a, b) if k > 0 else (b, a)
        lag = abs(k)
        nL, nF = NAME.get(leader, leader), NAME.get(follower, follower)

        lead_move = recent_return(px, leader, lag)
        foll_move = recent_return(px, follower, lag)

        if pd.isna(lead_move) or pd.isna(foll_move):
            continue

        gap = lead_move - foll_move

        if abs(gap) < gap_thresh:
            continue

        side = "BUY" if gap > 0 else "SELL"

        add_idea(
            ideas,
            score=min(abs(gap) / max(gap_thresh * 2, 0.01), 1.4),
            engine="Lead-lag catch-up",
            asset_class=pair_cls,
            name=f"{nL} leads {nF}",
            signal=f"{lag}d lead; leader {lead_move:+.1f}%, laggard {foll_move:+.1f}%",
            bias=f"{side} {nF}",
            detail=f"peak lead-lag r {pk:+.2f}, gap {gap:+.1f}%",
            quality="",
        )

    raw_ideas_df = pd.DataFrame(ideas).sort_values("score", ascending=False) if ideas else pd.DataFrame()
    ideas_df = cap_ideas(raw_ideas_df, max_per_engine=max_per_engine, max_per_asset_class=max_per_asset_class)

    return dict(
        px=px,
        iv=iv,
        rv=rv,
        ret=ret,
        iv_table=iv_table,
        corr_now=corr_now,
        disloc=disloc,
        ideas=ideas_df,
        raw_ideas=raw_ideas_df,
        lookback=lookback,
    )


